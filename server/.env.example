# ==============================================================================
# Aravalli Aadivasi Mahila Grih Udyog FPC — Backend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local mongodb instance)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aravalli_fpc?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aravalli_fpc?retryWrites=true&w=majority

# Custom DNS Servers (Optional, comma-separated IPs)
# Useful in corporate/institutional environments where Node's default loopback resolver (127.0.0.1)
# fails to resolve MongoDB Atlas SRV records.
# Example: DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

# JWT Secret Key (Required for Admin Authentication)
JWT_SECRET=your_secure_jwt_secret_key_change_in_production

# Allowed Client Origin for CORS (e.g. Vite frontend URL in dev, or production URL)
# For multiple production domains, separate by commas: https://aravallifpc.org,https://www.aravallifpc.org
CLIENT_URL=http://localhost:5173

# Initial Administrator Provisioning (used by scripts/createAdmin.js)
ADMIN_NAME=Aravalli Admin
ADMIN_EMAIL=admin@aravallifpc.org
ADMIN_PASSWORD=your_initial_admin_password_here
